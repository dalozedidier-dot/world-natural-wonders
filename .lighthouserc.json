{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/methode/index.html",
        "http://localhost/lieux/plitvice/index.html",
        "http://localhost/calendrier/index.html",
        "http://localhost/collections/index.html",
        "http://localhost/credits/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "onlyCategories": ["accessibility", "seo", "best-practices"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.98 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }]
      }
    }
  }
}
