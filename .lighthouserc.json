{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": ["http://localhost/index.html", "http://localhost/methode/index.html"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
