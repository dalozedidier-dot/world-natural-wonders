---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  image?: string | null;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  wide?: boolean;
  bodyClass?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | null;
}
const { title, description = "Cent paysages naturels qui racontent quatre milliards d'années d'histoire de la Terre, avec leurs saisons, leur géologie et les espèces qui les habitent.", image = '/social-card.jpg?v=20260824', imageAlt = '100 joyaux naturels de la Terre, atlas créé par Didier Daloze', imageWidth = 1200, imageHeight = 630, bodyClass = '', noindex = false, structuredData = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = new URL(Astro.url.pathname, Astro.site ?? 'https://example.org').href;
const origin = new URL(Astro.site ?? url).origin;
const socialImage = image ? new URL(image, origin).href : null;
const author = 'Didier Daloze';
const copyrightYear = new Date().getFullYear();
const graph = [
  {
    '@type': 'WebSite', '@id': `${origin}/#website`, url: `${origin}/`,
    name: '100 joyaux naturels de la Terre', alternateName: 'World Natural Wonders',
    description: "Atlas éditorial et calendrier de 100 paysages naturels remarquables.",
    inLanguage: 'fr-BE', creator: { '@id': `${origin}/#didier-daloze` },
    copyrightHolder: { '@id': `${origin}/#didier-daloze` }, copyrightYear
  },
  {
    '@type': 'Person', '@id': `${origin}/#didier-daloze`, name: author,
    url: `${origin}/`, owns: { '@id': `${origin}/#website` }
  },
  {
    '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, description,
    isPartOf: { '@id': `${origin}/#website` }, inLanguage: 'fr-BE',
    author: { '@id': `${origin}/#didier-daloze` },
    copyrightHolder: { '@id': `${origin}/#didier-daloze` }, copyrightYear,
    ...(socialImage ? { primaryImageOfPage: { '@type': 'ImageObject', url: socialImage, caption: imageAlt } } : {})
  },
  ...(structuredData ? [structuredData] : [])
];
const nav = [
  { href: `${base}/`, label: 'Carte' },
  { href: `${base}/collections`, label: 'Collections' },
  { href: `${base}/calendrier`, label: 'Calendrier' },
  { href: `${base}/explorer`, label: 'Deviner' },
  { href: `${base}/terre-en-mouvement`, label: 'La Terre en mouvement' }
];
const here = Astro.url.pathname.replace(/\/$/, '');
---
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="theme-color" content="#07100f" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={author} />
  <meta name="creator" content={author} />
  <meta name="copyright" content={`© ${copyrightYear} ${author} · world-natural-wonders.be`} />
  <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
  <meta name="googlebot" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
  <link rel="canonical" href={url} />
  <link rel="alternate" hreflang="fr-BE" href={url} />
  <link rel="alternate" hreflang="x-default" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="100 joyaux naturels de la Terre" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="fr_BE" />
  {socialImage && <meta property="og:image" content={socialImage} />}
  {socialImage && <meta property="og:image:url" content={socialImage} />}
  {socialImage && <meta property="og:image:secure_url" content={socialImage} />}
  {socialImage && <meta property="og:image:type" content="image/jpeg" />}
  {socialImage && <meta property="og:image:width" content={String(imageWidth)} />}
  {socialImage && <meta property="og:image:height" content={String(imageHeight)} />}
  {socialImage && <meta property="og:image:alt" content={imageAlt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {socialImage && <meta name="twitter:image" content={socialImage} />}
  {socialImage && <meta name="twitter:image:alt" content={imageAlt} />}
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${base}/favicon-32x32.png`} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} sizes="180x180" />
  <link rel="manifest" href={`${base}/site.webmanifest`} />
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main">Aller au contenu</a>
  <header class="topbar">
    <a class="brand" href={`${base}/`}>
      <span class="brand-mark">100</span>
      <span class="brand-text"><strong>Joyaux naturels</strong><small>de la Terre</small></span>
    </a>
    <nav aria-label="Navigation principale">
      {nav.map(n => (
        <a class="navlink" href={n.href} aria-current={here === n.href.replace(/\/$/, '') ? 'page' : undefined}>{n.label}</a>
      ))}
      <a class="navlink" href={`${base}/favoris`} id="favCount" data-fav-count>Favoris</a>
    </nav>
  </header>

  <main id="main"><slot /></main>

  <footer class="site">
    <div class="shell cols">
      <div>
        <h2 class="foot-title">Explorer</h2>
        <ul>
          <li><a href={`${base}/`}>Carte mondiale</a></li>
          <li><a href={`${base}/collections`}>Collections thématiques</a></li>
          <li><a href={`${base}/calendrier`}>Calendrier naturel</a></li>
          <li><a href={`${base}/comparer`}>Comparateur</a></li>
          <li><a href={`${base}/favoris`}>Mes listes</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot-title">À propos</h2>
        <ul>
          <li><a href={`${base}/credits`}>Crédits et licences</a></li>
          <li><a href="https://www.openstreetmap.org/copyright" rel="noopener">© OpenStreetMap</a></li>
          <li><a href={`${base}/donnees`}>Données ouvertes</a></li>
        </ul>
      </div>
      <div>
        <h2 class="foot-title">Avant de partir</h2>
        <p>Météo, accès, fermetures et règles locales changent. Vérifiez auprès du gestionnaire du site avant de vous mettre en route.</p>
        <p>Conception et contenus éditoriaux © {copyrightYear} Didier Daloze · <a href={`${origin}/`}>world-natural-wonders.be</a>.</p>
      </div>
    </div>
  </footer>

  <script>
    import { illustrateOnScroll } from '../scripts/photos';
    illustrateOnScroll();
  </script>

  <script>
    const KEY = 'wnw:lists:v1';
    try {
      const raw = localStorage.getItem(KEY);
      const lists = raw ? JSON.parse(raw) : { favorites: [], seen: [], someday: [] };
      const n = (lists.favorites || []).length;
      const el = document.querySelector('[data-fav-count]');
      if (el && n) el.textContent = `Favoris (${n})`;
    } catch {}
  </script>
</body>
</html>
