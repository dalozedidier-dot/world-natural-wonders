---
import { heroFor, label, placeholder } from '../data/places';
import type { Place } from '../data/types';
const { place } = Astro.props as { place: Place };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hero = heroFor(place);
---
<a class="card" href={`${base}/lieux/${place.id}`}>
  <div class="media">
    <img
      src={hero ? `${base}${hero.local.replace(/^public\//, '/')}` : placeholder(place)}
      alt={hero ? hero.alt : ''}
      loading="lazy" decoding="async"
      style="width:100%;height:100%;object-fit:cover" />
  </div>
  <div class="body">
    <h3>{place.identity.name_fr}{place.editorial.essential ? ' ✦' : ''}</h3>
    <p>{place.location.country_labels.join(' et ')} · {label.family(place.landscape.family)}</p>
    <p style="margin-top:.5rem;color:var(--paper-dim)">{place.editorial.lede}</p>
  </div>
</a>
