---
import Base from '../layouts/Base.astro';
import { places, taxonomies, heroFor, label } from '../data/places';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pool = places
  .filter(p => (p.editorial.guess_hints ?? []).length >= 2)
  .map(p => ({
    id: p.id,
    name: p.identity.name_fr,
    country: p.location.country_labels.join(' et '),
    region: label.region(p.location.region),
    family: label.family(p.landscape.family),
    hints: p.editorial.guess_hints,
    lede: p.editorial.lede,
    hero: heroFor(p)?.local.replace(/^public\//, '/') ?? null,
    alt: heroFor(p)?.alt ?? '',
    author: heroFor(p)?.author ?? null,
    license: heroFor(p) ? `${heroFor(p)!.license} ${heroFor(p)!.license_version}` : null,
    source: heroFor(p)?.source_page ?? null,
    color: taxonomies.families.find(f => f.id === p.landscape.family)?.color ?? '#c98a3f'
  }));
---
<Base title="Deviner un lieu · 100 joyaux naturels" description="Une photographie, trois indices, aucune réponse immédiate. Un mode d'exploration pour découvrir les cent joyaux sans lire la liste.">
  <section class="band shell" style="padding-top:7rem">
    <p class="eyebrow">Mode exploration</p>
    <h1>Où sommes-nous ?</h1>
    <p class="lead">Une image, quelques indices, pas de nom. Devinez, puis révélez le lieu et sa position sur le globe.</p>

    <div class="guess" style="margin-top:2.4rem" id="guess">
      <div class="guess-photo" data-photo></div>
      <div>
        <div class="guess-hints" data-hints></div>
        <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.2rem">
          <button class="btn btn--accent" data-reveal type="button">Révéler</button>
          <button class="btn" data-next type="button">Un autre lieu</button>
        </div>
        <div class="guess-answer" data-answer style="margin-top:1.6rem"></div>
      </div>
    </div>
    <p class="muted" data-credit style="margin-top:1.4rem;font-size:.74rem"></p>

    <script type="application/json" id="guess-pool" set:html={JSON.stringify(pool)} />
  </section>

  <script define:vars={{ base }}>
    const pool = JSON.parse(document.getElementById('guess-pool').textContent);
    const photo = document.querySelector('[data-photo]');
    const hints = document.querySelector('[data-hints]');
    const answer = document.querySelector('[data-answer]');
    const credit = document.querySelector('[data-credit]');
    const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    let cur = null;

    function pick() {
      if (!pool.length) { hints.innerHTML = '<p class="muted">Aucun lieu ne comporte encore d\'indices.</p>'; return; }
      cur = pool[Math.floor(Math.random() * pool.length)];
      photo.innerHTML = cur.hero
        ? `<img src="${base}${cur.hero}" alt="Photographie d'un lieu à deviner">`
        : `<div style="width:100%;height:100%;background:linear-gradient(140deg, ${cur.color}33, #0b1817);display:grid;place-items:center;color:var(--paper-mute)">Photographie à venir</div>`;
      hints.innerHTML = cur.hints.map(h => `<div class="guess-hint">${esc(h)}</div>`).join('');
      answer.classList.remove('is-open');
      answer.innerHTML = '';
      credit.textContent = '';
    }
    function reveal() {
      if (!cur) return;
      answer.classList.add('is-open');
      answer.innerHTML = `
        <p class="eyebrow" style="margin-bottom:.4rem">${esc(cur.region)} · ${esc(cur.family)}</p>
        <h2 style="margin-bottom:.3rem">${esc(cur.name)}</h2>
        <p class="muted">${esc(cur.country)}</p>
        <p>${esc(cur.lede)}</p>
        <p style="display:flex;gap:.5rem;flex-wrap:wrap">
          <a class="btn btn--accent" href="${base}/lieux/${cur.id}">Fiche complète</a>
          <a class="btn" href="${base}/?lieu=${cur.id}#carte">Voir sur la carte</a>
        </p>`;
      credit.innerHTML = cur.author ? `Photo : ${esc(cur.author)} · <a href="${cur.source}" rel="noopener" target="_blank">${esc(cur.license)}</a>` : '';
    }
    document.querySelector('[data-reveal]').addEventListener('click', reveal);
    document.querySelector('[data-next]').addEventListener('click', pick);
    pick();
  </script>
</Base>
