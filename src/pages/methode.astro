---
import Base from '../layouts/Base.astro';
import { renderMarkdown } from '../data/markdown';
import { places, taxonomies } from '../data/places';
import charte from '../../docs/charte-selection.md?raw';
import grille from '../../docs/grille-scoring.md?raw';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const byRegion = taxonomies.regions.map(r => ({
  ...r, n: places.filter(p => p.location.region === r.id).length
}));
const byStatus = taxonomies.editorialStatus.map(s => ({ s, n: places.filter(p => p.status === s).length })).filter(x => x.n);
---
<Base title="Méthode de sélection · 100 joyaux naturels" description="Charte de sélection, grille de notation à douze critères, quotas régionaux et typologiques, sources de présélection, statuts éditoriaux.">
  <section class="band shell" style="padding-top:7rem">
    <p class="eyebrow">Transparence</p>
    <h1>Comment ces cent lieux ont été choisis</h1>
    <p class="lead">Ce projet ne prétend pas démontrer quels sont les cent plus beaux lieux de la planète. La beauté n'est pas mesurable. Ce qui est vérifiable, en revanche, c'est la méthode : voici la charte complète et la grille de notation, telles qu'elles sont appliquées.</p>

    <div class="factgrid" style="margin:2.4rem 0">
      {byRegion.map(r => (
        <div class="fact">
          <dt>{r.label}</dt>
          <dd>{r.n} <span class="muted" style="font-size:.7rem">/ quota {r.quota[0]} à {r.quota[1]}</span></dd>
        </div>
      ))}
    </div>

    <div class="box" style="border:1px solid #ffffff14;border-radius:12px;padding:1.2rem;margin-bottom:2.4rem">
      <h3 style="font-family:var(--sans);font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--paper-mute)">Avancement éditorial</h3>
      <div class="chiprow" style="margin:0">
        {byStatus.map(x => <span class="badge badge--plain">{x.s} · {x.n}</span>)}
      </div>
      <p class="muted" style="margin:.8rem 0 0;font-size:.8rem">
        Un lieu passe par draft, research, fact_checked, media_checked, license_checked puis ready.
        L'intégration continue refuse le déploiement si un lieu publié ne satisfait pas le schéma ou les quotas.
      </p>
    </div>

    <div class="prose" set:html={renderMarkdown(charte)} />
    <div class="prose" style="margin-top:3rem" set:html={renderMarkdown(grille)} />

    <p style="margin-top:2.6rem;display:flex;gap:.5rem;flex-wrap:wrap">
      <a class="btn" href={`${base}/donnees`}>Données ouvertes</a>
      <a class="btn" href={`${base}/credits`}>Crédits et licences</a>
    </p>
  </section>
</Base>
