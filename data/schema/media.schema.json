{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-natural-wonders/schema/media.schema.json",
  "title": "Manifeste des médias",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "items"],
  "properties": {
    "version": { "type": "string" },
    "updated": { "type": "string", "format": "date" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "place", "role", "commons_file", "source_page", "author", "license", "license_version", "license_url", "verified_on", "width", "height", "alt", "local"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "place": { "type": "string" },
          "role": { "enum": ["hero", "gallery"] },
          "commons_file": { "type": "string", "description": "Nom exact du fichier sur Wikimedia Commons, sans le préfixe File:" },
          "source_page": { "type": "string", "format": "uri" },
          "author": { "type": "string" },
          "author_url": { "type": ["string", "null"] },
          "license": { "enum": ["CC0", "PD", "PD-Mark", "CC BY", "CC BY-SA"] },
          "license_version": { "type": "string" },
          "license_url": { "type": "string", "format": "uri" },
          "modifications": { "type": "string", "description": "Modifications réellement effectuées, ex. recadrage 3:2, conversion AVIF" },
          "verified_on": { "type": "string", "format": "date" },
          "verified_by": { "type": ["string", "null"] },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "alt": { "type": "string", "minLength": 15 },
          "caption": { "type": ["string", "null"] },
          "local": { "type": "string", "description": "Chemin du fichier original conservé dans le dépôt" }
        }
      }
    }
  }
}
